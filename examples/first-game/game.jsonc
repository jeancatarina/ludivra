{
  "schemaVersion": 4,
  "id": "first-game",
  "name": "First Ludivra Game",
  "engine": { "version": "0.7.0" },
  "targets": ["browser", "desktop", "native-headless"],
  "capabilities": ["authoring.asset-cooker"],
  "rendering": {
    "browser": {
      "profile": "web-compatible",
      "requiredFeatures": ["pbr", "shadows", "postprocess", "cpu-particles"],
      "optionalFeatures": ["instancing", "lod", "culling"],
      "fallbackProfiles": []
    },
    "desktop": {
      "profile": "desktop-high",
      "requiredFeatures": ["pbr", "shadows", "postprocess", "instancing", "lod", "culling"],
      "optionalFeatures": ["gpu-particles", "gpu-timestamps"],
      "fallbackProfiles": ["desktop-compatible"]
    }
  },
  "entrypoints": {
    "gameplay": "scripts/gameplay.lua",
    "presentation": "presentation/index.ts"
  },
  "assets": [
    {
      "id": "model.reference-triangle",
      "kind": "model",
      "format": "gltf",
      "source": "assets/models/reference-triangle.gltf",
      "origin": "ludivra-fixture",
      "license": "CC0-1.0",
      "targets": ["browser", "desktop"],
      "residency": {
        "class": "scene",
        "priority": 50,
        "cpuBudgetMiB": 1,
        "gpuBudgetMiB": 1
      },
      "import": { "units": "meters", "coordinateSystem": "right-handed-y-up" }
    }
  ],
  "inputs": [
    { "id": "charge", "label": "Carregar núcleo", "actionId": 1, "keys": ["Space", "Enter"] },
    { "id": "reset", "label": "Reiniciar", "actionId": 2, "keys": ["KeyR"] }
  ],
  "ui": {
    "defaultLocale": "en-US",
    "locales": [
      {
        "locale": "en-US",
        "entries": {
          "runtime.status": "Tick {tick}",
          "state.core.charge": "Core charge: {value}",
          "input.charge": "Charge core",
          "input.reset": "Reset"
        }
      }
    ],
    "minimumTouchTargetPx": 48,
    "minimumContrastRatio": 4.5,
    "breakpoints": [
      { "id": "compact", "minWidth": 320, "maxWidth": 599 },
      { "id": "wide", "minWidth": 600 }
    ]
  },
  "inspection": {
    "integerStates": [
      { "id": "core.charge", "label": "Carga do núcleo", "key": 1 }
    ]
  },
  "projectors": [
    {
      "projectorVersion": 1,
      "id": "ui.inspection",
      "kind": "ui-inspection",
      "screen": "game",
      "states": ["core.charge"],
      "inputs": ["charge", "reset"]
    }
  ],
  "scenarios": ["scenarios/charge-core.jsonc"],
  "audio": [
    {
      "id": "music.core-loop",
      "eventId": 1,
      "bus": "music",
      "loop": true,
      "autoplay": true,
      "volume": 0.08,
      "origin": "generated",
      "license": "project_owned",
      "synth": { "waveform": "sine", "frequency": 110, "durationMs": 1000 }
    },
    {
      "id": "audio.core.charge",
      "eventId": 2,
      "bus": "effects",
      "loop": false,
      "autoplay": false,
      "volume": 0.28,
      "origin": "generated",
      "license": "project_owned",
      "synth": { "waveform": "triangle", "frequency": 660, "durationMs": 90 }
    },
    {
      "id": "audio.core.reset",
      "eventId": 3,
      "bus": "effects",
      "loop": false,
      "autoplay": false,
      "volume": 0.22,
      "origin": "generated",
      "license": "project_owned",
      "synth": { "waveform": "square", "frequency": 180, "durationMs": 140 }
    }
  ],
  "effects": [
    {
      "id": "effect.core.burst",
      "eventId": 1,
      "type": "particle-burst",
      "color": 16766720,
      "count": 120,
      "size": 0.16,
      "speed": 1.8,
      "lifetimeMs": 5000,
      "gravity": 1.2
    }
  ],
  "steam": { "appId": null, "depotId": null },
  "desktop": { "updates": { "enabled": false, "feedUrl": null } }
}
