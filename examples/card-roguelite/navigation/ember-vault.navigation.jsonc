{
  "$schema": "https://ludivra.dev/schemas/navigation-map/v1",
  "schemaVersion": 1,
  "id": "navigation.ember-vault",
  "grid": {
    "width": 5,
    "height": 3,
    "blocked": [{ "x": 2, "z": 1 }]
  },
  "regions": [
    { "id": "navregion.ember-floor", "min": { "x": 0, "z": 0 }, "max": { "x": 4, "z": 2 }, "layers": 1 }
  ],
  "profiles": [
    { "id": "navprofile.ember-hero", "layers": 1, "maxExpandedNodes": 64 }
  ],
  "links": [
    { "id": "navlink.ember-bridge", "from": { "x": 1, "z": 1 }, "to": { "x": 3, "z": 1 }, "layers": 1, "cost": 1, "bidirectional": true }
  ]
}
