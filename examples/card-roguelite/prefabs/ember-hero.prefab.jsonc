{
  "$schema": "https://ludivra.dev/schemas/prefab/v1",
  "schemaVersion": 1,
  "id": "prefab.ember-hero",
  "root": "root",
  "resources": [],
  "parameters": [
    { "id": "faction", "type": "string", "default": "vault" }
  ],
  "overrides": [
    { "id": "appearance", "target": "body", "path": "/components/visual/resource", "type": "string" }
  ],
  "slots": [
    { "id": "weapon", "required": true }
  ],
  "nodes": [
    { "id": "root", "components": { "transform": { "position": [-1.5, 0, 0] } } },
    { "id": "body", "parent": "root", "components": { "visual": { "resource": "visual.ember-hero" } } }
  ]
}
