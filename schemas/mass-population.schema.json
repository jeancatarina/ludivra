{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludivra.dev/schemas/mass-population/v1",
  "title": "Ludivra Mass population",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "budget", "agents"],
  "properties": {
    "$schema": { "const": "https://ludivra.dev/schemas/mass-population/v1" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^mass\\.[a-z][a-z0-9.-]*$" },
    "budget": { "type": "object", "additionalProperties": false, "required": ["fullEntities", "simplifiedAgents", "aggregateGroups", "maximumQueryRadiusMilli", "maximumQueryResults"], "properties": { "fullEntities": { "type": "integer", "minimum": 0 }, "simplifiedAgents": { "type": "integer", "minimum": 0 }, "aggregateGroups": { "type": "integer", "minimum": 0 }, "maximumQueryRadiusMilli": { "type": "integer", "minimum": 0, "maximum": 1000000000 }, "maximumQueryResults": { "type": "integer", "minimum": 1 } } },
    "agents": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "level", "xMilli", "zMilli", "velocityXMilli", "velocityZMilli", "health"], "properties": { "id": { "type": "integer", "minimum": 1 }, "level": { "enum": ["full", "simplified", "aggregate", "visual", "density"] }, "xMilli": { "type": "integer" }, "zMilli": { "type": "integer" }, "velocityXMilli": { "type": "integer" }, "velocityZMilli": { "type": "integer" }, "health": { "type": "integer" } } } }
  }
}
