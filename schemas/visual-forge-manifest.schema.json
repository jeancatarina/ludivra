{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludivra.dev/schemas/visual-forge-manifest/v1",
  "title": "Ludivra Visual Forge artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "family", "id", "generator", "source", "inputs", "artifacts", "metrics", "validation", "regeneration"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "family": { "const": "visual" },
    "id": { "type": "string", "minLength": 1 },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "@ludivra/visual-authoring" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipe", "recipeSha256", "style", "styleSha256", "seed", "cacheKey"],
      "properties": {
        "recipe": { "type": "string", "minLength": 1 },
        "recipeSha256": { "$ref": "#/$defs/hash" },
        "style": { "type": "string", "minLength": 1 },
        "styleSha256": { "$ref": "#/$defs/hash" },
        "seed": { "type": "integer", "minimum": 0 },
        "cacheKey": { "$ref": "#/$defs/hash" }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "origin", "license", "sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "origin": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triangles", "vertices", "bones", "materials", "animations", "bounds"],
      "properties": {
        "triangles": { "type": "integer", "minimum": 1 },
        "vertices": { "type": "integer", "minimum": 1 },
        "bones": { "type": "integer", "minimum": 1 },
        "materials": { "type": "integer", "minimum": 1 },
        "animations": { "type": "integer", "minimum": 1 },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "$ref": "#/$defs/vector" },
            "max": { "$ref": "#/$defs/vector" }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "report"],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "report": { "type": "string", "minLength": 1 }
      }
    },
    "regeneration": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "vector": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "minItems": 3,
      "maxItems": 3
    }
  }
}
