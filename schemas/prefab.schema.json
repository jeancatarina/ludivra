{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludivra.dev/schemas/prefab/v1",
  "title": "Ludivra reusable text-first prefab",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "root", "nodes", "resources", "parameters", "overrides", "slots"],
  "properties": {
    "$schema": { "const": "https://ludivra.dev/schemas/prefab/v1" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^prefab\\.[a-z][a-z0-9.-]*$" },
    "base": { "type": "string", "pattern": "^prefab\\.[a-z][a-z0-9.-]*$" },
    "root": { "$ref": "https://ludivra.dev/schemas/scene/v1#/$defs/nodeId" },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/prefabNode" } },
    "resources": { "type": "array", "items": { "$ref": "https://ludivra.dev/schemas/scene/v1#/$defs/resource" } },
    "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
    "overrides": { "type": "array", "items": { "$ref": "#/$defs/override" } },
    "slots": { "type": "array", "items": { "$ref": "#/$defs/slot" } }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "default"],
      "properties": {
        "id": { "$ref": "https://ludivra.dev/schemas/scene/v1#/$defs/nodeId" },
        "type": { "enum": ["string", "integer", "number", "boolean"] },
        "default": { "$ref": "https://ludivra.dev/schemas/scene/v1#/$defs/primitive" }
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "path", "type"],
      "properties": {
        "id": { "$ref": "https://ludivra.dev/schemas/scene/v1#/$defs/nodeId" },
        "target": { "$ref": "https://ludivra.dev/schemas/scene/v1#/$defs/nodeId" },
        "path": { "type": "string", "pattern": "^/(?:[A-Za-z0-9_-]|~0|~1)+(?:/(?:[A-Za-z0-9_-]|~0|~1)+)*$" },
        "type": { "enum": ["string", "integer", "number", "boolean"] }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "required"],
      "properties": {
        "id": { "$ref": "https://ludivra.dev/schemas/scene/v1#/$defs/nodeId" },
        "required": { "type": "boolean" }
      }
    },
    "prefabNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "https://ludivra.dev/schemas/scene/v1#/$defs/nodeId" },
        "parent": { "$ref": "https://ludivra.dev/schemas/scene/v1#/$defs/nodeId" },
        "components": { "$ref": "https://ludivra.dev/schemas/scene/v1#/$defs/componentSet" }
      }
    }
  }
}
