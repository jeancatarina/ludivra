{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludivra.dev/schemas/spatial-world/v1",
  "title": "Ludivra regional spatial world",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "dimension", "regionExtentChunks", "entities"],
  "properties": {
    "$schema": { "const": "https://ludivra.dev/schemas/spatial-world/v1" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^world\\.[a-z][a-z0-9.-]*$" },
    "dimension": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "regionExtentChunks": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "position"],
        "properties": {
          "id": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
          "position": { "$ref": "#/$defs/position" }
        }
      }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xMilli", "yMilli", "zMilli"],
      "properties": {
        "xMilli": { "$ref": "#/$defs/coordinate" },
        "yMilli": { "$ref": "#/$defs/coordinate" },
        "zMilli": { "$ref": "#/$defs/coordinate" }
      }
    },
    "coordinate": {
      "type": "integer",
      "minimum": -68719476736000,
      "maximum": 68719476767999
    }
  }
}
