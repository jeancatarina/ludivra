{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludivra.dev/schemas/game/v4",
  "title": "Ludivra game manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "engine", "targets", "rendering", "entrypoints", "inputs", "ui", "inspection", "projectors", "scenarios"],
  "properties": {
    "schemaVersion": { "const": 4 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["browser", "desktop", "android", "ios", "native-headless"]
      }
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browser", "desktop"],
      "properties": {
        "browser": { "$ref": "#/$defs/renderProfile" },
        "desktop": { "$ref": "#/$defs/renderProfile" }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gameplay", "presentation"],
      "properties": {
        "gameplay": { "type": "string", "minLength": 1 },
        "presentation": { "type": "string", "minLength": 1 }
      }
    },
    "content": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "schema", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
          "schema": { "type": "string", "pattern": "^https://ludivra\\.dev/schemas/[a-z0-9-]+/v[0-9]+$" },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    },
    "spatial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worldContentId"],
      "properties": {
        "worldContentId": { "type": "string", "pattern": "^world\\.[a-z][a-z0-9.-]*$" }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenes", "prefabs"],
      "properties": {
        "scenes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "source"],
            "properties": {
              "id": { "type": "string", "pattern": "^scene\\.[a-z][a-z0-9.-]*$" },
              "source": { "type": "string", "minLength": 1 }
            }
          }
        },
        "prefabs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "source"],
            "properties": {
              "id": { "type": "string", "pattern": "^prefab\\.[a-z][a-z0-9.-]*$" },
              "source": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "statecharts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["charts", "events", "guards", "actions"],
      "properties": {
        "charts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "source"],
            "properties": {
              "id": { "type": "string", "pattern": "^statechart\\.[a-z][a-z0-9.-]*$" },
              "source": { "type": "string", "minLength": 1 }
            }
          }
        },
        "events": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "actionId"], "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" }, "actionId": { "type": "integer", "minimum": 1 } } } },
        "guards": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" } } } },
        "actions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" } } } }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "actionId", "keys"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "actionId": { "type": "integer", "minimum": 1 },
          "keys": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultLocale", "locales", "minimumTouchTargetPx", "minimumContrastRatio", "breakpoints"],
      "properties": {
        "defaultLocale": { "type": "string", "minLength": 2, "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$|^base$" },
        "locales": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["locale", "entries"],
            "properties": {
              "locale": { "type": "string", "minLength": 2, "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" },
              "entries": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "minimumTouchTargetPx": { "type": "integer", "minimum": 44, "maximum": 128 },
        "minimumContrastRatio": { "type": "number", "minimum": 4.5, "maximum": 21 },
        "breakpoints": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "minWidth"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "minWidth": { "type": "integer", "minimum": 1 },
              "maxWidth": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "timers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "key"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
          "key": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integerStates"],
      "properties": {
        "integerStates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "key"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
              "label": { "type": "string", "minLength": 1 },
              "key": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "projectors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://ludivra.dev/contracts/ui-inspection-projector/v1" }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "assets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "format", "source", "origin", "license", "targets", "residency", "import"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
          "kind": { "const": "model" },
          "format": { "enum": ["gltf", "glb"] },
          "source": { "type": "string", "minLength": 1 },
          "origin": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "targets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["browser", "desktop", "android", "ios", "native-headless"] }
          },
          "residency": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "priority", "cpuBudgetMiB", "gpuBudgetMiB"],
            "properties": {
              "class": { "enum": ["boot", "scene", "streamed", "transient"] },
              "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
              "cpuBudgetMiB": { "type": "number", "exclusiveMinimum": 0, "maximum": 4096 },
              "gpuBudgetMiB": { "type": "number", "exclusiveMinimum": 0, "maximum": 4096 }
            }
          },
          "import": {
            "type": "object",
            "additionalProperties": false,
            "required": ["units", "coordinateSystem"],
            "properties": {
              "units": { "const": "meters" },
              "coordinateSystem": { "const": "right-handed-y-up" }
            }
          }
        }
      }
    },
    "audio": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "eventId", "bus", "loop", "autoplay", "volume", "origin", "license"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
          "eventId": { "type": "integer", "minimum": 1 },
          "bus": { "enum": ["music", "ambience", "effects"] },
          "loop": { "type": "boolean" },
          "autoplay": { "type": "boolean" },
          "volume": { "type": "number", "minimum": 0, "maximum": 1 },
          "origin": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "recipe": { "type": "string", "minLength": 1 },
          "synth": {
            "type": "object",
            "additionalProperties": false,
            "required": ["waveform", "frequency", "durationMs"],
            "properties": {
              "waveform": { "enum": ["sine", "square", "sawtooth", "triangle"] },
              "frequency": { "type": "number", "minimum": 20, "maximum": 20000 },
              "durationMs": { "type": "integer", "minimum": 10, "maximum": 60000 }
            }
          }
        },
        "oneOf": [
          { "required": ["source"], "not": { "anyOf": [{ "required": ["synth"] }, { "required": ["recipe"] }] } },
          { "required": ["synth"], "not": { "anyOf": [{ "required": ["source"] }, { "required": ["recipe"] }] } },
          { "required": ["recipe"], "not": { "anyOf": [{ "required": ["source"] }, { "required": ["synth"] }] } }
        ]
      }
    },
    "effects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "eventId", "type", "color", "count", "size", "speed", "lifetimeMs", "gravity"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
          "eventId": { "type": "integer", "minimum": 1 },
          "type": { "const": "particle-burst" },
          "color": { "type": "integer", "minimum": 0, "maximum": 16777215 },
          "count": { "type": "integer", "minimum": 1, "maximum": 5000 },
          "size": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
          "speed": { "type": "number", "minimum": 0, "maximum": 100 },
          "lifetimeMs": { "type": "integer", "minimum": 16, "maximum": 60000 },
          "gravity": { "type": "number", "minimum": -100, "maximum": 100 }
        }
      }
    },
    "steam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appId", "depotId"],
      "properties": {
        "appId": { "type": ["integer", "null"], "minimum": 1 },
        "depotId": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "desktop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "updates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "feedUrl"],
          "properties": {
            "enabled": { "type": "boolean" },
            "feedUrl": {
              "type": ["string", "null"],
              "pattern": "^https://"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "rendererFeature": {
      "enum": ["pbr", "shadows", "postprocess", "cpu-particles", "gpu-particles", "instancing", "lod", "culling", "animation", "gamepad", "gpu-timestamps"]
    },
    "renderProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "requiredFeatures", "optionalFeatures", "fallbackProfiles"],
      "properties": {
        "profile": { "enum": ["web-compatible", "desktop-compatible", "desktop-high"] },
        "requiredFeatures": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/rendererFeature" } },
        "optionalFeatures": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/rendererFeature" } },
        "fallbackProfiles": { "type": "array", "uniqueItems": true, "items": { "enum": ["web-compatible", "desktop-compatible", "desktop-high"] } }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["capabilities"],
        "properties": { "capabilities": { "contains": { "const": "spatial.regional-world" } } }
      },
      "then": { "required": ["spatial"] }
    },
    {
      "if": { "required": ["spatial"] },
      "then": {
        "required": ["capabilities"],
        "properties": { "capabilities": { "contains": { "const": "spatial.regional-world" } } }
      }
    }
  ]
}
