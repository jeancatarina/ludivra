{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludivra.dev/schemas/visual-forge-manifest/v2",
  "title": "Ludivra source-free multi-render Visual Forge manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "family", "id", "generator", "source", "outputs", "validation", "regeneration"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "family": { "const": "visual" },
    "id": { "type": "string", "minLength": 1 },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "pipeline"],
      "properties": {
        "name": { "const": "@ludivra/visual-authoring" },
        "version": { "type": "integer", "minimum": 3 },
        "pipeline": { "const": "canonical-character-local" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "recipe", "recipeSha256", "style", "styleSha256", "seed", "cacheKey"],
      "properties": {
        "kind": { "const": "forge-recipe" },
        "recipe": { "type": "string", "minLength": 1 },
        "recipeSha256": { "$ref": "#/$defs/hash" },
        "style": { "type": "string", "minLength": 1 },
        "styleSha256": { "$ref": "#/$defs/hash" },
        "seed": { "type": "integer", "minimum": 0 },
        "cacheKey": { "$ref": "#/$defs/hash" }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mode", "profile", "quality", "generatedFrom", "artifacts", "metrics", "validation"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["2d", "2.5d", "3d"] },
          "profile": { "type": "string", "minLength": 1 },
          "quality": { "const": "production" },
          "generatedFrom": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "canonicalId", "recipeSha256"],
            "properties": {
              "kind": { "const": "canonical-character" },
              "canonicalId": { "type": "string", "minLength": 1 },
              "recipeSha256": { "$ref": "#/$defs/hash" }
            }
          },
          "artifacts": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "path", "sha256"],
              "properties": {
                "kind": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "$ref": "#/$defs/hash" }
              }
            }
          },
          "metrics": { "type": "object" },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "report"],
            "properties": {
              "status": { "enum": ["passed", "failed"] },
              "report": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "report"],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "report": { "type": "string", "minLength": 1 }
      }
    },
    "regeneration": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
