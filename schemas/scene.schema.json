{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludivra.dev/schemas/scene/v1",
  "title": "Ludivra text-first scene",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "root", "nodes", "resources"],
  "properties": {
    "$schema": { "const": "https://ludivra.dev/schemas/scene/v1" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^scene\\.[a-z][a-z0-9.-]*$" },
    "root": { "$ref": "#/$defs/nodeId" },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sceneNode" } },
    "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "nodeId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "primitive": { "type": ["string", "number", "boolean"] },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["visual", "audio", "vfx", "animation", "navigation"] },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "componentSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transform": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "position": { "$ref": "#/$defs/vector3" },
            "rotation": { "$ref": "#/$defs/vector3" },
            "scale": { "$ref": "#/$defs/vector3" }
          }
        },
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource"],
          "properties": {
            "resource": { "$ref": "#/$defs/id" },
            "visible": { "type": "boolean" }
          }
        },
        "light": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "color", "intensity"],
          "properties": {
            "kind": { "enum": ["ambient", "directional", "point", "spot"] },
            "color": { "type": "integer", "minimum": 0, "maximum": 16777215 },
            "intensity": { "type": "number", "minimum": 0 }
          }
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": ["projection"],
          "properties": { "projection": { "enum": ["orthographic", "perspective"] } }
        },
        "audioEmitter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource"],
          "properties": {
            "resource": { "$ref": "#/$defs/id" },
            "volume": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "vfxEmitter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource"],
          "properties": { "resource": { "$ref": "#/$defs/id" } }
        },
        "animation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["controller"],
          "properties": { "controller": { "$ref": "#/$defs/id" } }
        },
        "physics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["body"],
          "properties": { "body": { "enum": ["static", "dynamic", "kinematic"] } }
        },
        "navigation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["region"],
          "properties": { "region": { "$ref": "#/$defs/id" } }
        },
        "spawnBinding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": { "id": { "$ref": "#/$defs/id" } }
        }
      }
    },
    "instanceOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "value": { "$ref": "#/$defs/primitive" }
      }
    },
    "slotFill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prefab"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "prefab": { "type": "string", "pattern": "^prefab\\.[a-z][a-z0-9.-]*$" }
      }
    },
    "sceneNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "parent": { "$ref": "#/$defs/nodeId" },
        "prefab": { "type": "string", "pattern": "^prefab\\.[a-z][a-z0-9.-]*$" },
        "components": { "$ref": "#/$defs/componentSet" },
        "parameters": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/primitive" }
        },
        "overrides": { "type": "array", "items": { "$ref": "#/$defs/instanceOverride" } },
        "slots": { "type": "array", "items": { "$ref": "#/$defs/slotFill" } }
      }
    }
  }
}
