{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludivra.dev/schemas/character-spec/v2",
  "title": "Ludivra Forge-generated multi-render CharacterSpec",
  "description": "A source-free semantic recipe. The Forge generates the canonical mesh, rig, materials, textures and every 2D/2.5D view locally.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "style", "seed", "identity", "archetype", "anatomy", "face", "skin", "clothing", "equipment", "accessories", "animations", "surfaces", "outputs"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "$ref": "#/$defs/id" },
    "style": { "$ref": "#/$defs/id" },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "silhouette", "paletteRoles", "focalFeatures"],
      "properties": {
        "description": { "type": "string", "minLength": 20 },
        "silhouette": { "type": "string", "minLength": 10 },
        "paletteRoles": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "focalFeatures": { "type": "array", "minItems": 2, "maxItems": 12, "items": { "type": "string", "minLength": 3 } }
      }
    },
    "archetype": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "head"],
      "properties": {
        "body": { "enum": ["small-humanoid", "medium-humanoid"] },
        "head": { "enum": ["human", "goblin", "orc", "skeleton", "simple-demon"] }
      }
    },
    "anatomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heightM", "headScale", "shoulderScale", "armScale", "legScale", "posture"],
      "properties": {
        "heightM": { "type": "number", "minimum": 0.9, "maximum": 2.2 },
        "headScale": { "type": "number", "minimum": 0.7, "maximum": 1.5 },
        "shoulderScale": { "type": "number", "minimum": 0.7, "maximum": 1.5 },
        "armScale": { "type": "number", "minimum": 0.7, "maximum": 1.4 },
        "legScale": { "type": "number", "minimum": 0.7, "maximum": 1.4 },
        "posture": { "type": "number", "minimum": -1, "maximum": 1 }
      }
    },
    "face": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "eyes", "jaw", "nose"],
      "properties": {
        "generator": { "enum": ["human", "goblin", "orc", "skeleton", "simple-demon"] },
        "eyes": { "type": "number", "minimum": 0, "maximum": 1 },
        "jaw": { "type": "number", "minimum": 0, "maximum": 1 },
        "nose": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "skin": { "enum": ["skin", "bone", "stone", "crystal"] },
    "clothing": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/wearable" } },
    "equipment": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/equipment" } },
    "accessories": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/accessory" } },
    "animations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["idle", "walk", "run", "attack", "cast", "hit", "death", "interact"] }
    },
    "effects": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "colorRole", "anchor"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "colorRole": { "$ref": "#/$defs/id" },
          "anchor": { "enum": ["head", "left-hand", "right-hand", "chest", "feet"] }
        }
      }
    },
    "surfaces": {
      "description": "External surfaces are forbidden in schema v2; technical maps are generated by the Forge.",
      "type": "array",
      "maxItems": 0
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/output" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9]*([._-][a-z0-9]+)*$" },
    "material": { "enum": ["skin", "cloth", "leather", "wood", "bone", "metal", "stone", "crystal"] },
    "wearable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "material", "colorRole", "fit", "asymmetry"],
      "properties": {
        "type": { "enum": ["tunic", "robe", "cape", "light-armor", "wraps"] },
        "material": { "$ref": "#/$defs/material" },
        "colorRole": { "$ref": "#/$defs/id" },
        "fit": { "type": "number", "minimum": 0, "maximum": 1 },
        "asymmetry": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "equipment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "material", "hand", "scale"],
      "properties": {
        "type": { "enum": ["sword", "axe", "staff", "shield", "bow"] },
        "material": { "$ref": "#/$defs/material" },
        "hand": { "enum": ["left", "right", "both"] },
        "scale": { "type": "number", "minimum": 0.5, "maximum": 1.8 }
      }
    },
    "accessory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "material", "anchor", "scale"],
      "properties": {
        "type": { "enum": ["horns", "bones", "mask", "pouch", "necklace", "crystal"] },
        "material": { "$ref": "#/$defs/material" },
        "anchor": { "enum": ["head", "chest", "waist", "left-hand", "right-hand"] },
        "scale": { "type": "number", "minimum": 0.25, "maximum": 2 }
      }
    },
    "baseOutput": {
      "type": "object",
      "required": ["id", "mode", "profile", "quality"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "mode": { "enum": ["2d", "2.5d", "3d"] },
        "profile": { "$ref": "#/$defs/id" },
        "quality": { "const": "production" }
      }
    },
    "output": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/baseOutput" },
            {
              "additionalProperties": false,
              "required": ["resolution", "camera", "pixelsPerMeter", "padding", "edgeExtrusion", "animations"],
              "properties": {
                "id": true,
                "mode": { "const": "2d" },
                "profile": { "const": "illustrated-character-2d" },
                "quality": true,
                "resolution": { "type": "integer", "minimum": 768, "maximum": 2048 },
                "camera": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["yaw", "pitch"],
                  "properties": {
                    "yaw": { "type": "number", "minimum": 0, "maximum": 360 },
                    "pitch": { "type": "number", "minimum": -30, "maximum": 30 }
                  }
                },
                "pixelsPerMeter": { "type": "integer", "minimum": 128, "maximum": 2048 },
                "padding": { "type": "integer", "minimum": 2, "maximum": 64 },
                "edgeExtrusion": { "type": "integer", "minimum": 1, "maximum": 16 },
                "animations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/baseOutput" },
            {
              "additionalProperties": false,
              "required": ["cellResolution", "directions", "pixelsPerMeter", "padding", "edgeExtrusion", "animations"],
              "properties": {
                "id": true,
                "mode": { "const": "2.5d" },
                "profile": { "const": "directional-character-2.5d" },
                "quality": true,
                "cellResolution": { "type": "integer", "minimum": 256, "maximum": 1024 },
                "directions": {
                  "type": "array",
                  "minItems": 8,
                  "maxItems": 8,
                  "uniqueItems": true,
                  "items": { "enum": ["south", "south-west", "west", "north-west", "north", "north-east", "east", "south-east"] }
                },
                "pixelsPerMeter": { "type": "integer", "minimum": 64, "maximum": 1024 },
                "padding": { "type": "integer", "minimum": 2, "maximum": 64 },
                "edgeExtrusion": { "type": "integer", "minimum": 1, "maximum": 16 },
                "animations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/baseOutput" },
            {
              "additionalProperties": false,
              "required": ["requirements"],
              "properties": {
                "id": true,
                "mode": { "const": "3d" },
                "profile": { "const": "stylized-pbr-3d" },
                "quality": true,
                "requirements": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["minimumAnimations", "requiredAnimations", "maximumTriangles", "minimumTextureSize", "lods"],
                  "properties": {
                    "minimumAnimations": { "type": "integer", "minimum": 1 },
                    "requiredAnimations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
                    "maximumTriangles": { "type": "integer", "minimum": 100 },
                    "minimumTextureSize": { "type": "integer", "minimum": 128, "maximum": 512 },
                    "lods": { "type": "integer", "minimum": 1, "maximum": 8 }
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
