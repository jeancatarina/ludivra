{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludivra.dev/contracts/program-status.schema.json",
  "title": "Ludivra Program Status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "release",
    "currentFocus",
    "phases",
    "tasks",
    "targets",
    "proofGames"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "release": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "currentFocus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "summary", "next"],
      "properties": {
        "phase": { "type": "integer", "minimum": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "next": { "type": "string", "minLength": 1 }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/phase" }
    },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    },
    "proofGames": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/proofGame" }
    }
  },
  "$defs": {
    "adrId": {
      "type": "string",
      "pattern": "^\\d{4}$"
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "owners",
        "dependencies",
        "adrs",
        "objective",
        "delivered",
        "remaining",
        "gate"
      ],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["completed", "active", "partial", "planned"]
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "uniqueItems": true
        },
        "adrs": {
          "type": "array",
          "items": { "$ref": "#/$defs/adrId" },
          "uniqueItems": true
        },
        "objective": { "type": "string", "minLength": 1 },
        "delivered": {
          "type": "array",
          "items": { "$ref": "#/$defs/delivery" }
        },
        "remaining": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "gate": { "type": "string", "minLength": 1 }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "evidence"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "status", "phase", "work", "adrs"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
        "priority": { "enum": ["high", "medium", "low"] },
        "status": { "enum": ["in_progress", "planned", "blocked"] },
        "phase": { "type": "integer", "minimum": 1 },
        "work": { "type": "string", "minLength": 1 },
        "adrs": {
          "type": "array",
          "items": { "$ref": "#/$defs/adrId" },
          "uniqueItems": true
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "status", "current", "required"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["experimental", "not_run", "not_available", "future"]
        },
        "current": { "type": "string", "minLength": 1 },
        "required": { "type": "string", "minLength": 1 }
      }
    },
    "proofGame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "status", "proves"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string", "minLength": 1 },
        "status": { "enum": ["fixture", "planned", "completed"] },
        "proves": { "type": "string", "minLength": 1 }
      }
    }
  }
}
