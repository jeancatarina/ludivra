{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludivra.dev/contracts/rendered-ui-snapshot/v1",
  "title": "Ludivra rendered UI snapshot",
  "description": "Measured result produced by a UI renderer after layout. It reports what appeared, never what should exist; node identity, role and permitted actions belong to ui-view-model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "renderer", "viewport", "textScale", "locale", "breakpoint", "nodes"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "renderer": { "enum": ["headless-semantic-v1", "browser-dom-v1"] },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "textScale": { "type": "number", "exclusiveMinimum": 0 },
    "locale": { "type": "string", "minLength": 2 },
    "breakpoint": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bounds", "visible", "clipped", "focused", "text", "accessibleRole"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*([._-][a-z0-9]+)*$"
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number", "minimum": 0 },
            "height": { "type": "number", "minimum": 0 }
          }
        },
        "visible": { "type": "boolean" },
        "clipped": { "type": "boolean" },
        "focused": { "type": "boolean" },
        "text": { "type": "string" },
        "accessibleRole": { "type": "string", "minLength": 1 },
        "contrastRatio": { "type": "number", "minimum": 0 }
      }
    }
  }
}
