{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludivra.dev/contracts/ui-inspection-projector/v1",
  "title": "Ludivra UI inspection projector",
  "description": "A declared UI projector. It runs only after a committed authoritative state and receives a read-only state view.",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectorVersion", "id", "kind", "screen", "states", "inputs"],
  "properties": {
    "projectorVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/identifier" },
    "kind": { "const": "ui-inspection" },
    "screen": { "$ref": "#/$defs/identifier" },
    "states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*([._-][a-z0-9]+)*$"
    }
  },
  "x-ludivra": {
    "access": "read-only",
    "execution": "post-commit",
    "measurement": {
      "stateReads": "states.length",
      "uiNodes": "viewModel.nodes.length"
    }
  }
}
