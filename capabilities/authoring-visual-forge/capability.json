{
  "id": "authoring.visual-forge",
  "status": "experimental",
  "version": "0.3.0",
  "owner": "visual-authoring",
  "targets": ["native-headless", "browser", "electron"],
  "contracts": [
    "schemas/character-spec.schema.json",
    "schemas/character-spec-v2.schema.json",
    "schemas/texture-request.schema.json",
    "schemas/visual-forge-manifest.schema.json",
    "schemas/visual-forge-manifest-v2.schema.json",
    "schemas/visual-render-profile.schema.json",
    "schemas/visual-style.schema.json"
  ],
  "examples": [
    "visual-authoring/test/fixtures/goblin-shaman.character.json",
    "visual-authoring/test/fixtures/stylized/style.yaml",
    "visual-authoring/test/fixtures/production/visuals/goblin-shaman-production.character.json",
    "visual-authoring/test/fixtures/production/styles/stylized/style.yaml",
    "visual-authoring/test/fixtures/production/generated"
  ],
  "dependencies": ["presentation.three"],
  "verification": [
    "pnpm test:visual",
    "pnpm test:cli"
  ],
  "limitations": [
    {
      "code": "VISUAL_ARCHETYPE_SET_LIMITED",
      "message": "The production generator currently covers stylized small and medium humanoids; quadrupeds, vehicles and photoreal characters need additional canonical generators."
    },
    {
      "code": "VISUAL_LOD_GENERATION_LIMITED",
      "message": "The current production profile emits one gameplay mesh; automatic multi-LOD simplification is not implemented yet."
    },
    {
      "code": "VISUAL_RASTER_POSE_COVERAGE_LIMITED",
      "message": "2D and 2.5D currently render the canonical idle pose and directional views; skeletal animation clips are complete in 3D, while raster frame baking for every clip is the next priority."
    }
  ]
}
