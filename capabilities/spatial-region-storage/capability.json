{
  "id": "spatial.region-storage",
  "status": "experimental",
  "version": "0.1.0",
  "owner": "kernel",
  "targets": ["native-headless"],
  "contracts": [
    "kernel/src/region_storage.hpp",
    "runtime-c-api/include/ludivra/region_storage.h",
    "cli/src/commands/storage.ts",
    "docs/adr/0023-world-persistence-and-region-storage.md"
  ],
  "examples": [
    "tests/kernel/kernel_test.cpp"
  ],
  "dependencies": ["spatial.regional-world", "runtime.save-replay"],
  "verification": [
    "pnpm test:native",
    "pnpm test:cli",
    "pnpm build:wasm"
  ],
  "limitations": [
    {
      "code": "WORLD_REGION_STORAGE_RUNTIME_BINDING_UNAVAILABLE",
      "message": "O armazenamento nativo já preserva deltas e journal, mas o Runtime/Lua ainda não seleciona regiões para save ou replay de jogo."
    },
    {
      "code": "WORLD_REGION_STORAGE_WEB_UNAVAILABLE",
      "message": "A CLI publica inspect, recover, compact e migrate para os envelopes nativos; ainda não há adapter Web nem binding de memória do runtime."
    }
  ]
}
