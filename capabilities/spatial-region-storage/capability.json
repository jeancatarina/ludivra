{
  "id": "spatial.region-storage",
  "status": "experimental",
  "version": "0.1.0",
  "owner": "kernel",
  "targets": ["native-headless"],
  "contracts": [
    "kernel/src/region_storage.hpp",
    "runtime-c-api/include/ludivra/region_storage.h",
    "docs/adr/0023-world-persistence-and-region-storage.md"
