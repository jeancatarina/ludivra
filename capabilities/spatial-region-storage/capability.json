    {
      "code": "WORLD_REGION_STORAGE_CLI_UNAVAILABLE",
      "message": "Inspect, compact e migrate existem nos boundaries kernel/C nativos, mas os comandos CLI e o adapter Web ainda não foram publicados."
    }
  ]
