{
  "id": "runtime.content-binding",
  "status": "experimental",
  "version": "0.2.0",
  "owner": "content-compiler",
  "targets": ["native-headless", "browser", "electron"],
  "contracts": [
    "schemas/game.schema.json",
    "schemas/card-roguelite.schema.json"
  ],
  "examples": [
    "examples/card-roguelite/content/run.jsonc"
  ],
  "dependencies": ["runtime.lua-gameplay"],
  "verification": [
    "pnpm test:content",
    "pnpm test:native",
    "pnpm test:card-roguelite"
  ],
  "limitations": [
    {
      "code": "CONTENT_MIGRATIONS_NOT_IMPLEMENTED",
      "message": "The versioned content pack is compiled and loaded by the kernel, but explicit schema migration chains and their fixtures are not implemented."
    },
    {
      "code": "CONTENT_NULL_NOT_SUPPORTED",
      "message": "The experimental Lua content binding rejects JSON null instead of assigning it ambiguous Lua nil semantics."
    }
  ]
}
