{
  "id": "network.loopback-room",
  "status": "experimental",
  "version": "0.1.0",
  "owner": "kernel",
  "targets": ["native-headless", "browser", "electron"],
  "contracts": [
    "kernel/src/network_session.hpp",
    "runtime-c-api/include/ludivra/network.h",
    "runtime-web/src/index.ts",
    "hosts/browser/src/network/room-bridge.ts",
    "docs/adr/0024-player-hosted-multiplayer-and-protocol-compatibility.md",
    "docs/adr/0038-network-transport-adapters.md"
  ],
  "examples": [
    "tests/kernel/kernel_test.cpp"
  ],
  "dependencies": ["runtime.save-replay", "spatial.region-storage"],
  "verification": [
    "pnpm test:native",
    "pnpm test:wasm-equivalence",
    "pnpm --filter @ludivra/browser-host build"
  ],
  "limitations": [
    {
      "code": "NETWORK_DIVERGENCE_LOCALIZATION_PENDING",
      "message": "A sala publica snapshots canônicos e valida identidade, mas ainda não produz a primeira localização remota de divergência por tick/chunk."
    }
  ]
}
