{
  "id": "network.webrtc-datachannel",
  "status": "experimental",
  "version": "0.1.0",
  "owner": "hosts/browser",
  "targets": ["browser", "electron"],
  "contracts": [
    "hosts/browser/src/network/webrtc-transport.ts",
    "docs/adr/0038-network-transport-adapters.md"
  ],
  "examples": [
    "hosts/browser/src/network/webrtc-transport.ts"
  ],
  "dependencies": ["network.loopback-room"],
  "verification": [
    "pnpm --filter @ludivra/browser-host build"
  ],
  "limitations": [
    {
      "code": "NETWORK_SIGNALING_PLAYER_OWNED",
      "message": "O adapter serializa offer/answer copiáveis, mas troca de signaling é uma decisão do jogador e nunca serviço operado pela engine."
    },
    {
      "code": "NETWORK_WEBRTC_SIGNALING_MANUAL",
      "message": "O bridge de sala é público, mas o jogador ainda realiza a troca de signaling e inicia os DataChannels explicitamente."
    }
  ]
}
